# Copy to .env.local. Never commit real values.
# Firebase Console > Project settings > General > Your apps > Web app config.
# NEXT_PUBLIC_* values are public and embedded at BUILD TIME; rebuild after changes.
NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace-with-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=replace-with-app-id

# Server only. Firebase Console > Project settings > Service accounts.
# Use the SAME Firebase project as the web app. Choose ONE credential format.
# Option A: single-line service-account JSON (takes precedence over individual fields).
# FIREBASE_SERVICE_ACCOUNT_JSON='{"project_id":"your-project","client_email":"firebase-adminsdk@example.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\nREPLACE\n-----END PRIVATE KEY-----\n"}'
# Option B: individual fields. Literal \n sequences in the private key are supported.
FIREBASE_ADMIN_PROJECT_ID=your-project
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE\n-----END PRIVATE KEY-----\n"

# Server only. This default is a paid model; select a model available to your account.
OPENROUTER_API_KEY=replace-with-openrouter-api-key
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Positive integers. Defaults shown. See docs/phase-1.md for ranges and behavior.
CHAT_MAX_MESSAGE_CHARS=8000
CHAT_HISTORY_MAX_MESSAGES=20
CHAT_HISTORY_MAX_CHARS=24000
CHAT_MAX_OUTPUT_TOKENS=1024

# Per-user chat quota. Redis outages fail open with a warning; see docs/phase-3.md.
REDIS_URL=redis://localhost:6379
CHAT_RATE_LIMIT_MAX_REQUESTS=10
CHAT_RATE_LIMIT_WINDOW_SECONDS=60

# PostgreSQL, server only. Replace the password; never commit the real URL.
DATABASE_URL=postgresql://consumer_compass:replace-with-db-password@localhost:5432/consumer_compass
# Optional, only for npm run test:db. Use a migrated, disposable database ending in _test.
# TEST_DATABASE_URL=postgresql://consumer_compass:replace-with-test-db-password@localhost:55432/consumer_compass_test
# Optional, only for npm run test:redis. Use a disposable Redis service.
# TEST_REDIS_URL=redis://localhost:56379/15
