# Docker Compose env_file format: raw. No shell quotes around values.
# Keep this on EC2 as runtime.env with mode 600; never commit real credentials.
LOG_LEVEL=info
# Until credentials are configured, the demo's protected APIs remain unavailable.
# FIREBASE_SERVICE_ACCOUNT_JSON={"project_id":"...","client_email":"...","private_key":"...\n..."}
# OPENROUTER_API_KEY=...
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# CHAT_MAX_MESSAGE_CHARS=8000
# CHAT_HISTORY_MAX_MESSAGES=20
# CHAT_HISTORY_MAX_CHARS=24000
# CHAT_MAX_OUTPUT_TOKENS=1024
# CHAT_RATE_LIMIT_MAX_REQUESTS=10
# CHAT_RATE_LIMIT_WINDOW_SECONDS=60
