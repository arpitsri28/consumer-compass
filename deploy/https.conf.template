log_format compass escape=json '{"event":"http_request","deployment":"${DEPLOYMENT_ID}","requestId":"$correlation_id","method":"$request_method","path":"$uri","status":$status,"latencySeconds":$request_time}';
access_log /dev/stdout compass;
server {
    listen 80 default_server;
    server_name ${DOMAIN};
    location ^~ /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 308 https://${DOMAIN}$request_uri; }
}
server {
    listen 443 ssl default_server;
    server_name ${DOMAIN};
    ssl_certificate /etc/letsencrypt/live/consumer-compass/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/consumer-compass/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:1m;
    ssl_session_timeout 1d;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Request-ID $correlation_id always;

    location / {
        proxy_pass http://app:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header X-Request-ID;
    }
    location = /api/chat {
        proxy_pass http://app:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header X-Request-ID;
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_read_timeout 150s;
    }
}
